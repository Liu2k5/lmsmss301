entryY=0.5;" value="" edge="1" source="a-student" target="G-R1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#2E7D32;strokeWidth=1;opacity=55;jumpStyle=arc;jumpSize=4;labelBackgroundColor=#FFFFFF;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="" edge="1" source="a-instructor" target="G-R1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e39" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#2E7D32;strokeWidth=1;opacity=55;jumpStyle=arc;jumpSize=4;labelBackgroundColor=#FFFFFF;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="" edge="1" source="a-instructor" target="G-R2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e40" parent="1" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endFill=0;strokeColor=#7030A0;strokeWidth=1;opacity=55;jumpStyle=arc;jumpSize=4;labelBackgroundColor=#FFFFFF;exitPerimeter=0;entryPerimeter=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" value="" edge="1" source="a-admin" target="G-R3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#1F3864;whiteSpace=wrap;" value="&lt;b&gt;Use Case Overview — LearnHub LMS&lt;/b&gt; (76 use case / 5 service / 5 actor)" vertex="1"><mxGeometry x="40" y="30" width="1200" height="30" as="geometry"/></mxCell><mxCell id="legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9E6;strokeColor=#D6B656;fontColor=#7F6000;fontSize=10;align=left;verticalAlign=top;spacing=4;size=14;" value="&lt;b&gt;Chú thích&lt;/b&gt;&lt;br&gt;• Khung lớn = &lt;b&gt;system boundary&lt;/b&gt; của một microservice (mỗi service sở hữu use case của mình).&lt;br&gt;• Ellipse = &lt;b&gt;nhóm use case&lt;/b&gt; (gộp các UC liên tiếp cùng nghiệp vụ); tên đầy đủ + mã ở các trang sau.&lt;br&gt;• Màu ellipse: &lt;b&gt;xanh&lt;/b&gt; = nghiệp vụ thường, &lt;b&gt;vàng&lt;/b&gt; = use case thuộc &lt;b&gt;Key Challenge&lt;/b&gt; (access control / progress tracking).&lt;br&gt;• Màu đường kết nối = actor: &lt;font color=&quot;#B45F06&quot;&gt;Guest&lt;/font&gt;, &lt;font color=&quot;#1F6FEB&quot;&gt;Student&lt;/font&gt;, &lt;font color=&quot;#2E7D32&quot;&gt;Instructor&lt;/font&gt;, &lt;font color=&quot;#7030A0&quot;&gt;Admin&lt;/font&gt;, &lt;font color=&quot;#C00000&quot;&gt;System&lt;/font&gt;.&lt;br&gt;• Số use case: User 16 · Course 30 · Enrollment 8 · Progress 11 · Review &amp;amp; Rating 11 = &lt;b&gt;76&lt;/b&gt;.&lt;br&gt;• Trang 01–05: use case diagram chi tiết cho từng actor · trang 06: 7 use case &lt;b&gt;Key Challenge&lt;/b&gt;." vertex="1"><mxGeometry x="40" y="690" width="1340" height="100" as="geometry"/></mxCell><mxCell id="G-C1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#2E5395;fontColor=#1F3864;fontSize=10;align=center;verticalAlign=middle;spacing=2;" value="&lt;b&gt;Quản lý khoá học&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;UC-C01…C03&lt;/font&gt;" vertex="1"><mxGeometry x="280" y="220" width="340" height="56" as="geometry"/></mxCell><mxCell id="G-C2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#2E5395;fontColor=#1F3864;fontSize=10;align=center;verticalAlign=middle;spacing=2;" value="&lt;b&gt;Curriculum: chương &amp; bài học&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;UC-C04…C10&lt;/font&gt;" vertex="1"><mxGeometry x="280" y="294" width="340" height="56" as="geometry"/></mxCell><mxCell id="G-C3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#2E5395;fontColor=#1F3864;fontSize=10;align=center;verticalAlign=middle;spacing=2;" value="&lt;b&gt;Học liệu video / tài liệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-