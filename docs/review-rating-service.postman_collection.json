{
	"info": {
		"_postman_id": "review-rating-service-lms-fa26",
		"name": "LearnHub LMS - Review & Rating Service",
		"description": "Collection kiểm thử đầy đủ các API của Review & Rating Service (Port 8085). Không cần bản quyền IDE.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8085",
			"type": "string"
		},
		{
			"key": "courseId",
			"value": "2a3df3a6-bd47-43b9-91aa-8fb7a13236a8",
			"type": "string"
		},
		{
			"key": "studentId",
			"value": "11111111-1111-1111-1111-111111111111",
			"type": "string"
		},
		{
			"key": "instructorId",
			"value": "22222222-2222-2222-2222-000000000007",
			"type": "string"
		},
		{
			"key": "adminId",
			"value": "33333333-3333-3333-3333-000000000001",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Public APIs",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/actuator/health",
							"host": ["{{baseUrl}}"],
							"path": ["actuator", "health"]
						}
					}
				},
				{
					"name": "Xem Rating Summary khóa học",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/courses/{{courseId}}/ratings/summary",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "courses", "{{courseId}}", "ratings", "summary"]
						}
					}
				},
				{
					"name": "Xem danh sách Reviews",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/courses/{{courseId}}/reviews?page=0&size=10&sort=newest",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "courses", "{{courseId}}", "reviews"],
							"query": [
								{ "key": "page", "value": "0" },
								{ "key": "size", "value": "10" },
								{ "key": "sort", "value": "newest" }
							]
						}
					}
				}
			]
		},
		{
			"name": "2. Student APIs",
			"item": [
				{
					"name": "Kiểm tra quyền đánh giá (Eligibility)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-User-Id", "value": "{{studentId}}" },
							{ "key": "X-User-Role", "value": "student" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/courses/{{courseId}}/reviews/eligibility",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "courses", "{{courseId}}", "reviews", "eligibility"]
						}
					}
				},
				{
					"name": "Tạo đánh giá mới (5 sao)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-User-Id", "value": "{{studentId}}" },
							{ "key": "X-User-Role", "value": "student" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rating\": 5,\n  \"comment\": \"Khóa học rất xuất sắc, thực hành rõ ràng!\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/courses/{{courseId}}/reviews",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "courses", "{{courseId}}", "reviews"]
						}
					}
				},
				{
					"name": "Xem lịch sử đánh giá cá nhân (My Reviews)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "X-User-Id", "value": "{{studentId}}" },
							{ "key": "X-User-Role", "value": "student" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/my-reviews",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "my-reviews"]
						}
					}
				},
				{
					"name": "Vote Helpful cho review",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "X-User-Id", "value": "{{studentId}}" },
							{ "key": "X-User-Role", "value": "student" }
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/reviews/1/helpful",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "reviews", "1", "helpful"]
						}
					}
				}
			]
		},
		{
			"name": "3. Instructor APIs",
			"item": [
				{
					"name": "Giảng viên phản hồi nhận xét (Reply)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-User-Id", "value": "{{instructorId}}" },
							{ "key": "X-User-Role", "value": "instructor" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"Cảm ơn em đã gửi phản hồi tích cực! Chúc em học tốt.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/reviews/1/replies",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "reviews", "1", "replies"]
						}
					}
				}
			]
		},
		{
			"name": "4. Admin APIs",
			"item": [
				{
					"name": "Admin duyệt hoặc ẩn Review",
					"request": {
						"method": "PATCH",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "X-User-Id", "value": "{{adminId}}" },
							{ "key": "X-User-Role", "value": "admin" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"status\": \"APPROVED\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/admin/reviews/1/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "admin", "reviews", "1", "status"]
						}
					}
				}
			]
		}
	]
}
